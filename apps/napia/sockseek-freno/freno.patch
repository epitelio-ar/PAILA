+// </copyright>
+
+namespace Soulseek.Network
+{
+    using System;
+    using System.Threading;
+    using System.Threading.Tasks;
+
+    /// <summary>
+    ///     Limits the outbound connections that the server asks us to make (ConnectToPeer, type "P").
+    /// </summary>
+    /// <remarks>
+    ///     When our listening port can't be reached, every peer with search results asks the server to make us connect to
+    ///     them. A popular search produces thousands of these requests within a few seconds; opening all of them at once
+    ///     overflows the connection table of many home routers, which then drops every new connection (downloads included)
+    ///     for seconds to minutes. This keeps a small number in flight, spaces their start, and drops the ones that waited
+    ///     too long (losing some search results, never a download). Tunable with environment variables:
+    ///     SOULSEEK_SOLICITED_MAX (in flight, default 48), SOULSEEK_SOLICITED_PER_SECOND (default 25) and
+    ///     SOULSEEK_SOLICITED_WAIT_MS (max wait in the queue, default 6000). SOULSEEK_SOLICITED_MAX=0 turns it off.
+    /// </remarks>
+    internal static class SolicitedConnectionThrottle
+    {
+        private static readonly int Max = Read("SOULSEEK_SOLICITED_MAX", 48);
+        private static readonly int PerSecond = Math.Max(1, Read("SOULSEEK_SOLICITED_PER_SECOND", 25));
+        private static readonly TimeSpan MaxWait = TimeSpan.FromMilliseconds(Read("SOULSEEK_SOLICITED_WAIT_MS", 6000));
+        private static readonly SemaphoreSlim InFlight = new SemaphoreSlim(Math.Max(1, Max));
+        private static readonly object SpacingLock = new object();
+        private static DateTime nextStart = DateTime.MinValue;
+        private static long dropped;
+
+        /// <summary>
+        ///     Gets a value indicating whether the throttle is on.
+        /// </summary>
+        public static bool Enabled => Max > 0;
+
+        /// <summary>
+        ///     Gets how many requests were dropped since the start.
+        /// </summary>
+        public static long Dropped => Interlocked.Read(ref dropped);
+
+        /// <summary>
+        ///     Runs <paramref name="connect"/> when there's room, or returns false if it would wait longer than allowed.
+        /// </summary>
+        /// <param name="connect">The connection attempt.</param>
+        /// <returns>False if the request was dropped.</returns>
+        public static async Task<bool> RunAsync(Func<Task> connect)
+        {
+            if (!Enabled)
+            {
+                await connect().ConfigureAwait(false);
+                return true;
+            }
+
+            var deadline = DateTime.UtcNow + MaxWait;
+
+            // spacing: reserve the next start slot; if it's past the deadline, drop without reserving it
+            TimeSpan delay;
+            lock (SpacingLock)
+            {
+                var now = DateTime.UtcNow;
+                var start = nextStart > now ? nextStart : now;
+
+                if (start > deadline)
+                {
+                    Interlocked.Increment(ref dropped);
+                    return false;
+                }
+
+                nextStart = start + TimeSpan.FromSeconds(1.0 / PerSecond);
+                delay = start - now;
+            }
+
+            if (delay > TimeSpan.Zero)
+            {
+                await Task.Delay(delay).ConfigureAwait(false);
+            }
+
+            var remaining = deadline - DateTime.UtcNow;
+
+            if (!await InFlight.WaitAsync(remaining > TimeSpan.Zero ? remaining : TimeSpan.Zero).ConfigureAwait(false))
+            {
+                Interlocked.Increment(ref dropped);
+                return false;
+            }
+
+            try
+            {
+                await connect().ConfigureAwait(false);
+                return true;
+            }
+            finally
+            {
+                InFlight.Release();
+            }
+        }
+
+        private static int Read(string name, int fallback)
+            => int.TryParse(Environment.GetEnvironmentVariable(name), out var value) && value >= 0 ? value : fallback;
+    }
+}
