{
  "name": "paila",
  "productName": "PAILA",
  "version": "1.0.2",
  "description": "Ver, ordenar, mejorar y hacer lugar en tu biblioteca de música. Para cualquiera con mucha música, con funciones extra para DJs.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "main": "out/main/arranque.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "pack": "electron-vite build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "essentia.js": "^0.1.3",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "libarchive-wasm": "1.2.0",
    "node-taglib-sharp": "^6.0.3"
  },
  "devDependencies": {
    "@paila/core": "*",
    "@paila/diseno": "*",
    "@paila/shared": "*",
    "@tanstack/react-virtual": "3.14.13",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.6",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.8.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "7.3.7"
  },
  "pailaActualizaciones": {
    "activas": true,
    "feed": "https://github.com/epitelio-ar/PAILA/releases/latest/download"
  },
  "build": {
    "appId": "ar.paila.app",
    "productName": "PAILA",
    "copyright": "© 2026 Bllly Shears · AGPL-3.0-or-later",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/**"
    ],
    "extraResources": [
      { "from": "../napia/out", "to": "napia/out" },
      { "from": "../napia/build/icon.png", "to": "napia/build/icon.png" },
      { "from": "../napia/build/icon.ico", "to": "napia/build/icon.ico" },
      { "from": "recursos/modelos", "to": "modelos" }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        { "from": "../napia/recursos/sockseek", "to": "napia/recursos/sockseek" },
        { "from": "recursos/mpv", "to": "mpv" },
        { "from": "recursos/ffprobe", "to": "ffprobe" }
      ],
      "extraFiles": [
        { "from": "build/AVISOS-DE-TERCEROS.txt", "to": "AVISOS-DE-TERCEROS.txt" }
      ],
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PAILA",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "3082",
      "installerLanguages": ["es_ES", "en_US"],
      "multiLanguageInstaller": true,
      "include": "build/instalador.nsh"
    },
    "portable": {
      "artifactName": "PAILA-portable-${version}.exe"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "minimumSystemVersion": "12.0",
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "extraResources": [
        { "from": "recursos/mpv-mac/${arch}", "to": "mpv" },
        { "from": "recursos/mpv", "to": "mpv", "filter": ["*.txt"] },
        { "from": "../napia/recursos/sockseek-mac/${arch}", "to": "napia/recursos/sockseek" },
        { "from": "../napia/recursos/sockseek", "to": "napia/recursos/sockseek", "filter": ["*.txt", "LICENSE"] },
        { "from": "build/AVISOS-DE-TERCEROS.txt", "to": "AVISOS-DE-TERCEROS.txt" }
      ],
      "artifactName": "PAILA-mac-${arch}-${version}.${ext}"
    },
    "dmg": {
      "title": "PAILA ${version}",
      "format": "ULFO"
    },
    "artifactName": "PAILA-instalador-${version}.${ext}",
    "publish": [
      { "provider": "github", "owner": "epitelio-ar", "repo": "PAILA", "releaseType": "draft" }
    ],
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ]
  }
}
