{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["apps/paila/electron", "apps/paila/ui/src", "apps/paila/electron.vite.config.ts", "apps/napia/electron", "apps/napia/ui/src", "apps/napia/electron.vite.config.ts", "packages", "scripts"]
}
